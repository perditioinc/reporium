{
  "name": "reporium",
  "version": "0.1.0",
  "description": "Your GitHub knowledge library — visualize and explore all your public repos",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:privacy && node scripts/write-corpus-constants.cjs && node scripts/sync-data-dir.cjs",
    "refresh-stats": "node scripts/write-corpus-constants.cjs",
    "build": "npx tsx scripts/generate-sitemap.ts && next build",
    "build:analyze": "npx tsx scripts/generate-sitemap.ts && node -e \"process.env.ANALYZE='true'; require('child_process').execSync('next build --webpack', { stdio: 'inherit', env: process.env })\"",
    "postbuild": "node scripts/strip-large-static-json.cjs",
    "sitemap": "npx tsx scripts/generate-sitemap.ts",
    "generate": "npx tsx scripts/fetch-library.ts",
    "generate:resilient": "npx tsx scripts/generate-with-fallback.ts && npx tsx scripts/validate-privacy.ts",
    "validate:privacy": "npx tsx scripts/validate-privacy.ts",
    "generate:legacy": "npx tsx scripts/generate-library.ts",
    "generate:quick": "npx tsx scripts/generate-library.ts --quick",
    "generate:weekly": "npx tsx scripts/generate-library.ts --weekly",
    "generate:full": "npx tsx scripts/generate-library.ts --full",
    "generate:build": "npm run generate:resilient && npm run build",
    "validate": "npx tsx scripts/validate-library.ts",
    "fix-builders": "npx tsx scripts/fix-builders.ts",
    "fix-fork-info": "npx tsx scripts/fix-fork-info.ts",
    "detect-trends": "npx tsx scripts/detect-trends.ts",
    "gap-analysis": "npx tsx scripts/build-gap-analysis.ts",
    "digest": "npx tsx scripts/generate-digest.ts",
    "build:faq": "npx tsx scripts/build-faq.ts",
    "refresh": "npm run generate && npm run validate && npm run detect-trends && npm run gap-analysis && npm run digest && npm run build:faq",
    "rebuild": "powershell -ExecutionPolicy Bypass -File scripts/rebuild.ps1",
    "rebuild:full": "powershell -ExecutionPolicy Bypass -File scripts/rebuild.ps1 -full",
    "rebuild:dev": "powershell -ExecutionPolicy Bypass -File scripts/rebuild.ps1 -dev",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "mcp": "npx tsx src/mcp/index.ts",
    "cli": "npx tsx src/cli/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sentry/nextjs": "^10.49.0",
    "@types/three": "^0.183.1",
    "d3-force": "^3.0.0",
    "d3-force-3d": "^3.0.6",
    "framer-motion": "^12.38.0",
    "next": "16.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  }
}
