# Required for GitHub data fetching (lite mode generation)
GH_TOKEN=your_github_personal_access_token
GH_USERNAME=your_github_username

# Optional: connect to reporium-api for production mode
# Leave unset to use lite mode (static JSON files)
NEXT_PUBLIC_REPORIUM_API_URL=

# SERVER-SIDE ONLY (auth-hardening plan PR #5+#7) — no NEXT_PUBLIC_ prefix, so
# these are never inlined into the client bundle. They are read at runtime by
# the same-origin proxy routes (src/app/api/intelligence/*), which attach the
# app token before forwarding to reporium-api.
#
# reporium-api base URL used by the server-side proxy. Falls back to
# NEXT_PUBLIC_REPORIUM_API_URL if unset.
REPORIUM_API_URL=
# App token for /intelligence/ask, /intelligence/ask/stream and
# /intelligence/nl-filter. Replaces the removed NEXT_PUBLIC_APP_API_TOKEN
# (which exposed the token in the client bundle — never reintroduce it).
# Ask the project owner for the dev token, or leave blank to disable local ask.
REPORIUM_APP_TOKEN=

# Set automatically for GitHub Pages deployment
NEXT_PUBLIC_BASE_PATH=
