# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
tmp-*.spec.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
.env.local

# sentry
.sentryclirc
.env.sentry-build-plugin

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
.claude/

# generated data cache (not needed in git)
public/data/cache.json
public/data/repo-cache.json
public/data/meta.json

# data/ is synced from public/data/ at prebuild — not tracked in git
/data/*.json
# KAN-172: repo-slugs.json is a build-time stub (committed as []) so that
# `tsc --noEmit` (which runs before prebuild in CI) can resolve the import in
# middleware.ts. The real allowlist is regenerated by scripts/build-repo-slugs.cjs
# during prebuild on every build. Stub stays empty (fail-closed: if prebuild
# ever silently doesn't run, every /repo/<slug> 404s rather than 200s).
!/data/repo-slugs.json

# local audit/baseline artifacts (ephemeral, never commit)
.audit-status-*.md
.baseline-*.md
